<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.rememberme.dunoesanchaeg.trophies.mapper.TrophyMapper">

    <resultMap id="TrophyResultMap" type="com.rememberme.dunoesanchaeg.trophies.domain.Trophy">
        <id property="trophyId" column="trophy_id"/>
        <result property="memberId" column="member_id"/>
        <result property="trophyType" column="trophy_type"/>
        <result property="acquiredAt" column="acquired_at"/>
    </resultMap>

    <sql id="trophyColumns">
        t.trophy_id,
        t.member_id,
        t.trophy_type,
        t.acquired_at
    </sql>

    <select id="existsByMemberIdAndTrophyType" resultType="boolean">
        SELECT EXISTS(
            SELECT 1
            FROM trophy
            WHERE member_id = #{memberId}
              AND trophy_type = #{trophyType}
        )
    </select>

    <insert id="insertTrophy"
            parameterType="com.rememberme.dunoesanchaeg.trophies.domain.Trophy"
            useGeneratedKeys="true"
            keyProperty="trophyId">
        INSERT INTO trophy (
            member_id,
            trophy_type,
            acquired_at
        ) VALUES (
                     #{memberId},
                     #{trophyType},
                     NOW()
                 )
    </insert>

    <select id="findTrophiesByMemberId"
            resultMap="TrophyResultMap">
        SELECT
        <include refid="trophyColumns"/>
        FROM trophy t
        WHERE t.member_id = #{memberId}
        ORDER BY t.acquired_at DESC, t.trophy_id DESC
    </select>

</mapper>